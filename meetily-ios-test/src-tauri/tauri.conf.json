{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "meetily-ios-test",
  "version": "0.1.0",
  "identifier": "com.michael.meetily-ios-test",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "meetily-ios-test",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "assets/models/ggml-large-v3-turbo.bin",
      "assets/models/qwen2.5-7b-instruct-q4_k_m.gguf",
      "assets/audio/*.wav"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
